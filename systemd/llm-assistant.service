[Unit]
Description=Dynamic local Qwen3 assistant for AI Video Site
After=network-online.target comfyui.service comfyui-secondary.service
Wants=network-online.target

[Service]
Type=simple
User=openfun
Group=openfun
WorkingDirectory=/opt/ai/aivideosite
Environment=PYTHONUNBUFFERED=1
Environment=LLM_SERVER_BIN=/opt/ai/llama.cpp/build/bin/llama-server
Environment=LLM_MODEL=/opt/ai/models/llm/Qwen3-8B-abliterated-Q4_K_M.gguf
Environment=LLM_HOST=127.0.0.1
Environment=LLM_PORT=8090
Environment=LLM_CONTROL_HOST=127.0.0.1
Environment=LLM_CONTROL_PORT=8091
Environment=LLM_CTX_SIZE=32768
Environment=LLM_THREADS=18
Environment=LLM_GPU_POLL_SECONDS=2
# The manager owns localhost:8090. Clean up a leftover manual/legacy
# llama-server before it starts so an old test process cannot block binding.
ExecStartPre=-/usr/bin/pkill -f llama-server.*--port[[:space:]]+8090
ExecStart=/usr/bin/python3 /opt/ai/aivideosite/app/llm_assistant_manager.py
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
