# Web
# Arbitrary password-only users are supported.
# Option A: numbered entries. Add SITE_USER4_..., SITE_USER5_..., etc. as needed.
# Empty numbered passwords are ignored. If no users are configured and no
# data/.site_users.json exists, the app creates three random local profiles.
SITE_USER1_ID=user1
SITE_USER1_NAME=Пользователь 1
SITE_USER1_PASSWORD=
SITE_USER2_ID=user2
SITE_USER2_NAME=Пользователь 2
SITE_USER2_PASSWORD=
SITE_USER3_ID=user3
SITE_USER3_NAME=Пользователь 3
SITE_USER3_PASSWORD=
# Option B: one JSON list/dict (takes priority over numbered entries).
# SITE_USERS_JSON=[{"id":"user1","label":"OpenFun","password":"123456","enabled":true}]
SESSION_SECRET=auto
HOST=0.0.0.0
PORT=8000

# Paths
DATA_DIR=/opt/ai/aivideosite/data
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_SECONDARY_URL=http://127.0.0.1:8189
COMFYUI_OUTPUT_DIR=/opt/ai/ComfyUI/output
COMFYUI_INPUT_DIR=/opt/ai/ComfyUI/input

# Local Gemma4 26B A4B assistant
LLM_ASSISTANT_URL=http://127.0.0.1:8090
LLM_MANAGER_URL=http://127.0.0.1:8091
LLM_ASSISTANT_MODEL=gemma-4-26B-A4B-it-uncensored-heretic

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# MiniMax H3 model filenames already installed in ComfyUI
H3_FL2VA_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_REF2VA_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
H3_TURBO_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
H3_REF_TURBO_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
H3_CONTROLNET_MODEL_PATCH=minimax_h3_fun_controlnet_union_pruned_int8_convrot.safetensors
H3_ATTENTION_BACKEND=comfy kitchen attention

# Upload limits in MiB
MAX_IMAGE_UPLOAD_MB=40
MAX_VIDEO_UPLOAD_MB=500
MAX_AUDIO_UPLOAD_MB=300
